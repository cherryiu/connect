    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-navigation/elements": "^2.9.36",
    "@react-navigation/native": "^7.3.14",
